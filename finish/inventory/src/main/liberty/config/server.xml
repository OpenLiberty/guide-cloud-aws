<server description="Sample Liberty server">

  <featureManager>
    <platform>jakartaee-10.0</platform>
    <platform>microprofile-6.1</platform>
    <feature>restfulWS</feature>
    <feature>jsonb</feature>
    <feature>cdi</feature>
    <feature>mpRestClient</feature>
    <feature>mpConfig</feature>
    <feature>jsonp</feature>
  </featureManager>

  <variable name="system.http.port" defaultValue="9080"/>
  <variable name="http.port" defaultValue="9080"/>
  <variable name="https.port" defaultValue="9443"/>

  <httpEndpoint host="*" httpPort="${http.port}" httpsPort="${https.port}" id="defaultHttpEndpoint"/>

  <webApplication location="guide-cloud-aws-inventory.war" contextRoot="/"/>
</server>
